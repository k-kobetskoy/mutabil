{
  "name": "mutabil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/start-standalone.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "contract:gen": "tsx scripts/gen-contract.ts",
    "contract:check": "tsx scripts/gen-contract.ts --check",
    "vectors:gen": "tsx scripts/gen-vectors.ts",
    "vectors:check": "tsx scripts/gen-vectors.ts --check",
    "go:gen": "cd api && go generate ./...",
    "go:test": "cd api && go test ./..."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.4",
    "idb-keyval": "^6.3.0",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^1.52.0",
    "lz-string": "^1.5.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod-openapi": "^6.0.2"
  },
  "packageManager": "pnpm@10.28.0"
}
